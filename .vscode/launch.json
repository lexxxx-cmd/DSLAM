    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++ Debug (gdb Launch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Examples/RGB-D/rgbd_tum",
            "args": ["Vocabulary/ORBvoc.txt",
            "Examples/RGB-D/TUM3.yaml",
            "/home/data/TUM/rgbd_dataset_freiburg3_walking_xyz",
            "/home/data/TUM/rgbd_dataset_freiburg3_walking_xyz/associations.txt",
            "TrajSave/tum/walking_xyz/old"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}